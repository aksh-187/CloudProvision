# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Session ─────────────────────────────────────────────────────────────────
# Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# ─── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to project root or absolute)
DATABASE_PATH=./backend/database/cloudprovision.sqlite

# ─── AWS ─────────────────────────────────────────────────────────────────────
# Terraform uses the standard AWS credential chain.
# Configure via `aws configure` or set these environment variables.
# Do NOT commit real values.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ─── Terraform ───────────────────────────────────────────────────────────────
# Absolute path to the terraform_workspaces directory
# Defaults to <project_root>/terraform_workspaces if not set
TERRAFORM_WORKSPACES_PATH=./terraform_workspaces

# Path to Terraform binary (leave empty if terraform is in PATH)
# On Windows if Terraform is not on PATH, set the full path:
# TERRAFORM_BIN=C:\Terraform\terraform.exe
# TERRAFORM_BIN=terraform
