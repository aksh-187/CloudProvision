{
  "name": "cloudprovision",
  "version": "0.1.0",
  "description": "Self-service infrastructure provisioning tool — provisions real AWS infrastructure via Terraform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "better-sqlite3-session-store": "0.1.0",
    "bcrypt": "6.0.0",
    "dotenv": "18.0.5",
    "express": "4.22.3",
    "express-session": "1.19.0",
    "express-validator": "7.3.2",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "supertest": "7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "better-sqlite3@13.0.3": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
